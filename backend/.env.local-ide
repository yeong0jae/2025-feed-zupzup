# IntelliJ IDE 로컬 실행용 환경 변수

# 타임존
TZ=Asia/Seoul

# OpenTelemetry 설정
OTEL_SERVICE_NAME=feed-zupzup
OTEL_RESOURCE_ATTRIBUTES=service.name=feed-zupzup,deployment.environment=local-ide
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_JAVAAGENT_DISABLED_INSTRUMENTATIONS=micrometer
OTEL_INSTRUMENTATION_HTTP_SERVER_EXCLUDE_URLS=/actuator/.*
